{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoseCToscano/xdr-cap-coverage-kit/schema/corpus-entry.schema.json",
  "title": "XDR/CAP coverage corpus entry (draft v0)",
  "description": "One entry = one rare but valid XDR shape. Language neutral: any SDK or indexer reads the base64 and checks the expected values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "caps", "protocol", "network", "xdr", "provenance", "expected"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable ID. Never reused, even if the entry is removed."
    },
    "title": { "type": "string", "maxLength": 200 },
    "caps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CAP-[0-9]{4}(-[0-9]{2})?$" },
      "description": "CAPs that introduced or changed this shape. Use CAP-0000 for shapes that predate the CAP process (base protocol)."
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introduced_in", "captured_on"],
      "properties": {
        "introduced_in": { "type": "integer", "minimum": 0, "description": "First protocol version where core can emit this shape." },
        "captured_on": { "type": "integer", "minimum": 0, "description": "Protocol version of the ledger the entry came from (or the XDR version it was built against, for synthetic entries)." },
        "xdr_ref": { "type": "string", "description": "stellar-xdr git commit or tag the expected values were produced with." }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passphrase"],
      "properties": {
        "passphrase": {
          "enum": [
            "Test SDF Network ; September 2015",
            "Public Global Stellar Network ; September 2015",
            "Standalone Network ; February 2017",
            "none"
          ],
          "description": "Needed to recompute a transaction hash. 'none' for values that are not signed (ScVal, LedgerKey, ...)."
        },
        "expected_tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "xdr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "base64", "sha256"],
      "properties": {
        "type": { "type": "string", "description": "XDR type name as in stellar-xdr, e.g. TransactionEnvelope, ScVal, LedgerCloseMeta." },
        "base64": { "type": "string", "contentEncoding": "base64" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the raw XDR bytes. Re-encoding must reproduce it." },
        "file": { "type": "string", "description": "Optional path to a .xdr file when the value is too large to inline (LedgerCloseMeta)." }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["testnet", "mainnet", "local-core", "synthetic"] },
        "ledger": { "type": "integer", "minimum": 1 },
        "tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_url": { "type": "string", "format": "uri" },
        "captured_at": { "type": "string", "format": "date-time" },
        "tool": { "type": "string", "description": "Script and version that produced the entry." },
        "synthetic_reason": { "type": "string", "description": "Required when kind is synthetic: why no core-emitted capture exists yet, and how one would be made." }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "synthetic" } } }, "then": { "required": ["synthetic_reason"] } },
        { "if": { "properties": { "kind": { "enum": ["testnet", "mainnet"] } } }, "then": { "required": ["ledger", "source_url"] } }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "checks"],
      "properties": {
        "json": { "description": "SEP-51 XDR-JSON of the value, produced by rs-stellar-xdr. Every SDK's decode must agree with it." },
        "checks": {
          "type": "array",
          "minItems": 1,
          "description": "Semantic facts a reader must get right. Paths are JSON Pointers into expected.json.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "op", "note"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "op": { "enum": ["equals", "length", "strkey", "preserved", "not-dropped"] },
              "value": {},
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "muxed", "muxed-max-id", "signed-payload", "issuer-sort", "max-length",
          "nested-auth", "key-collision", "non-utf8", "sac", "events", "state-archival", "lcm"
        ]
      }
    },
    "linked_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "role"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "role": { "enum": ["reproduces", "regression", "related"] },
          "component": { "type": "string" }
        }
      }
    }
  }
}
